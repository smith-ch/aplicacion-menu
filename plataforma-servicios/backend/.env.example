# Servidor
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Seguridad
JWT_SECRET=cambia-esta-clave-super-secreta
JWT_EXPIRES_IN=7d

# Usuario administrador inicial (se crea al primer arranque)
ADMIN_EMAIL=admin@fisc.com.do
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# Base de datos: sqlite (desarrollo) o postgres (producción)
DB_TYPE=sqlite
DB_SQLITE_PATH=data/plataforma.sqlite
# DB_TYPE=postgres
# DATABASE_URL=postgres://usuario:clave@localhost:5432/plataforma
DB_SYNCHRONIZE=true

# Archivos subidos (fotos de trabajos, comprobantes, logos)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Integración Concrebill (ERP / facturación con NCF)
# Con CONCREBILL_ENABLED=false la plataforma funciona en modo simulado y registra
# cada llamada en la bitácora de integración del panel administrativo.
CONCREBILL_ENABLED=false
CONCREBILL_BASE_URL=https://api.concrebill.com/v1
CONCREBILL_API_KEY=

# PayPal (se activará más adelante)
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
